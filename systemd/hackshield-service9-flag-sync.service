[Unit]
Description=Synchronize Service 9 flag into MongoDB
After=mongod.service
Requires=mongod.service

[Service]
Type=oneshot
EnvironmentFile=/etc/hackshield/service9.env
ExecStart=/usr/local/libexec/hackshield-service9-flag-sync
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
