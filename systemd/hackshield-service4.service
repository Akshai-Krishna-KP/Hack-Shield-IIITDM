[Unit]
Description=Hack and Shield - Service 4 WikiLink Preview (SSRF Lab)
After=network.target

[Service]
Type=simple
User=user4
Group=user4
WorkingDirectory=/opt/hackshield/services/service4
EnvironmentFile=/run/hackshield/service4.env
ExecStart=/opt/hackshield/services/service4/.venv/bin/python /opt/hackshield/services/service4/run_all.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
