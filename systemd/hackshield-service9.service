[Unit]
Description=Hack and Shield - Vulnerable Service 9 (Build Vault NoSQL injection)
After=network.target mongod.service
Requires=mongod.service

[Service]
Type=simple
User=user9
Group=user9
WorkingDirectory=/opt/hackshield/services/service9
EnvironmentFile=/run/hackshield/service9.env
EnvironmentFile=/etc/hackshield/service9.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/hackshield/services/service9/.venv/bin/python /opt/hackshield/services/service9/app.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
