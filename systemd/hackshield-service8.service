[Unit]
Description=Hack and Shield - Vulnerable Service 8 (JWT)
After=network.target

[Service]
Type=simple
User=user8
Group=user8
WorkingDirectory=/opt/hackshield/services/service8
EnvironmentFile=/etc/hackshield/service8.env
Environment=PORT=5001
ExecStart=/opt/hackshield/services/service8/.venv/bin/python /opt/hackshield/services/service8/app.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
