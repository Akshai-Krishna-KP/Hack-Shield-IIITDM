[Unit]
Description=Hack and Shield - Service 7 Employee Portal (Client-side Trust Lab)
After=network.target

[Service]
Type=simple
User=user7
Group=user7
WorkingDirectory=/opt/hackshield/services/service7
ExecStart=/opt/hackshield/services/service7/.venv/bin/python /opt/hackshield/services/service7/app.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
